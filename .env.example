# Copy to .env (local) — never commit .env itself.
# Frontend reads VITE_* vars at build/dev time; the server reads PORT.

# Realtime server port (server/index.cjs)
PORT=3000

# Where the frontend finds the realtime server.
# Local dev (vite :5173 + server :3000): keep as below.
# Production (same host serves both): set to "" or the public URL.
VITE_SYNCSPACE_SERVER_URL=http://localhost:3000

# MongoDB connection string for the auth store (server/db.cjs).
# Local dev: mongodb://127.0.0.1:27017/syncspace
# Never commit a real value here — copy this file to .env and fill it in.
MONGODB_URI=

# Secret used to sign auth JWTs (server/auth.cjs). Use a long random
# string in production. Never expose to the frontend.
JWT_SECRET=

# Google OAuth client ID (public identifier, safe for the frontend).
# Server verifies ID tokens against this audience; the frontend uses it
# for the Google Identity Services button. No client secret is used.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
