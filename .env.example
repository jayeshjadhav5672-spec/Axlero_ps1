# Copy to .env (local) — never commit .env itself.
# Frontend reads VITE_* vars at build/dev time; the server reads PORT.

# Realtime server port (server/index.cjs)
PORT=3000

# Where the frontend finds the realtime server.
# Local dev (vite :5173 + server :3000): keep as below.
# Production (same host serves both): set to "" or the public URL.
VITE_SYNCSPACE_SERVER_URL=http://localhost:3000

# Google OAuth client ID (public identifier, safe for the frontend).
# Used by the frontend Google Identity Services button
# (src/components/auth/GoogleButton.jsx via src/lib/auth.js).
# No client secret is used anywhere.
VITE_GOOGLE_CLIENT_ID=
