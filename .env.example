# Copy to .env (local) — never commit .env itself.
# Frontend reads VITE_* vars at build/dev time; the server reads PORT.

# Realtime server port (server/index.cjs)
PORT=3000

# Where the frontend finds the realtime server.
# VITE_* is a build-time variable: it is baked into the browser bundle by
# `npm run build`. Changing it afterwards does NOT update an already-built
# frontend — set it first, then rebuild and redeploy.
# Preferred: VITE_BACKEND_URL (used by CI / Cloudflare Pages build).
# Legacy alias VITE_SYNCSPACE_SERVER_URL is still honored.
# Local dev (vite :5173 + server :3000): keep as below.
# Production (Railway backend + Cloudflare Pages frontend): set the
# public Railway backend URL explicitly, e.g.
#   VITE_BACKEND_URL=https://<railway-backend>.up.railway.app
# Do NOT use "" — an empty value falls back to http://localhost:3000.
VITE_BACKEND_URL=http://localhost:3000
VITE_SYNCSPACE_SERVER_URL=http://localhost:3000

# MongoDB Atlas connection (backend reads MONGODB_URI; never commit .env).
# Ask the team lead for the database password and put it in your local .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/axlero?appName=Cluster0

# JWT signing secret for auth tokens (server/auth/tokens.js).
# Generate a strong random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# NEVER commit the real secret — local .env only.
JWT_SECRET=<strong-random-secret-at-least-16-characters>

# JWT lifetime (anything jsonwebtoken accepts: "15m", "12h", "7d"). Default: 7d.
JWT_EXPIRES_IN=7d

# Firebase client configuration (frontend reads VITE_* vars at build time).
# These are public configuration identifiers, NOT secrets.
# Get them from Firebase Console → Project Settings → General → Your apps.
VITE_FIREBASE_API_KEY=<firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<firebase-project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<firebase-project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
VITE_FIREBASE_APP_ID=<app-id>

# Firebase Admin credentials (backend only — never expose to frontend).
# Get from Firebase Console → Project Settings → Service accounts → Generate new private key.
# Store the three fields below as environment variables in your deployment.
# NEVER commit the service-account JSON file itself (see .gitignore).
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<firebase-project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# Frontend origin(s) allowed to call the API (comma-separated, no wildcard).
# Local dev: Vite picks any free port (5173, 5174, 5175, ...). The server
# allows any http://localhost:<port> / http://127.0.0.1:<port> origin while
# NOT in production, so listing every port is unnecessary — but you may still
# list explicit origins here and they are always honored, e.g.:
#   FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
# Production: set NODE_ENV=production AND the exact public frontend
# origin(s), e.g. the Cloudflare Pages domain:
#   NODE_ENV=production
#   FRONTEND_ORIGIN=https://syncspace-frontend.pages.dev
# Multiple origins (preview + production) are comma-separated:
#   FRONTEND_ORIGIN=https://syncspace-frontend.pages.dev,https://main.syncspace-frontend.pages.dev
# The localhost rule is disabled on Render AND Railway even if NODE_ENV is
# unset, because hosted services are detected via RENDER=true (Render) or
# RAILWAY_ENVIRONMENT (Railway).
# Never use a localhost FRONTEND_ORIGIN in production.
FRONTEND_ORIGIN=http://localhost:5173
